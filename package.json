{
  "name": "e-sekolah-api",
  "version": "1.0.0",
  "description": "Unified Lightweight REST API for E-Sekolah (Android App & Web Desktop)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed:keuangan": "node src/seeders/keuangan.seeder.js",
    "build": "cd client && npm install && npm run build",
    "deploy": "git pull origin main && npm run build && pm2 restart all"
  },
  "keywords": [
    "express",
    "mysql",
    "e-sekolah",
    "absensi",
    "rest-api"
  ],
  "author": "Antigravity Dev Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.9.7",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "@whiskeysockets/baileys": "^6.7.9"
  }
}
